# Misen deployment configuration.
#
#   cp .env.example .env   &&   edit   &&   never commit .env
#
# Every key the stack reads is listed here. Secrets are intentionally blank —
# fill them in on the host. Non-secret values carry working defaults, which
# double as documentation of the expected shape.

# ---------------------------------------------------------------------------
# Domains — all three must already resolve to this host before first start,
# or Caddy's certificate requests will fail.
# ---------------------------------------------------------------------------
ACME_EMAIL=
MEALIE_DOMAIN=mealie.misen.example.com
API_DOMAIN=api.misen.example.com
MCP_DOMAIN=mcp.misen.example.com

# ---------------------------------------------------------------------------
# Host paths. DATA_DIR holds every bind mount; BACKUP_DIR is where nightly
# archives land before being copied off-box. Absolute paths in production.
# ---------------------------------------------------------------------------
DATA_DIR=./data
BACKUP_DIR=./backups
BACKUP_RETAIN_DAYS=30

# ---------------------------------------------------------------------------
# Locale. TZ drives Mealie's timestamps, the Companion's week boundaries, and
# the hour that plan reminders fire.
# ---------------------------------------------------------------------------
TZ=America/New_York

# ---------------------------------------------------------------------------
# Mealie. PUID/PGID must match the owner of $DATA_DIR/mealie on the host or
# Mealie will fail to write. `id -u` / `id -g` for the deploying user.
# ---------------------------------------------------------------------------
MEALIE_PUID=1000
MEALIE_PGID=1000
MEALIE_DEFAULT_EMAIL=
# Password for that first admin login. Read only on the very first boot, when
# Mealie creates the admin row — editing it afterwards has no effect, and the
# real password lives in Mealie's database from then on. Set it to something
# you generated; you will change it in the UI at step 5 regardless.
MEALIE_DEFAULT_PASSWORD=
MEALIE_DEFAULT_GROUP=misen
MEALIE_DEFAULT_HOUSEHOLD=home

# API token minted in Mealie's UI after first login:
# profile → API Tokens → Generate. Used by Companion and the MCP server.
MEALIE_API_TOKEN=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# There is no model API key here. Misen never calls a model: planning happens
# in a Claude Project, and that conversation is billed to the person's Claude
# subscription rather than to this deployment.
#
# The MCP server has no token of its own either. Callers present their own
# member token (minted by scripts/provision.py) and it is forwarded to
# Companion, so there is one credential per person and one place to rotate it.

# ---------------------------------------------------------------------------
# Instacart — nothing to configure here.
# ---------------------------------------------------------------------------
# Misen contains no Instacart code (PRD decision 2), and no longer proxies to
# it either. Ordering works by adding Instacart's own MCP server to the same
# Claude Project as a second connector, alongside Misen's — so that credential
# lives in the person's claude.ai account, not on this host.
