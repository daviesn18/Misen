{
  "info": {
    "_postman_id": "8a75903e-e705-49f1-9df9-d107e68c7553",
    "name": "Misen Companion API",
    "description": "Every endpoint in PRD \u00a75, plus the failure paths.\n\nSet `base_url` and `token` in the collection variables. `token` is a member token minted by `scripts/provision.py`; it resolves to both a member and a household, so no request ever names a household.\n\nRequests that capture an id into a variable are marked \u2014 run the folders in order the first time.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.misen.example.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "week_start",
      "value": "2026-08-10",
      "description": "must be the household's week_starts_on day"
    },
    {
      "key": "recipe_slug",
      "value": "roast-chicken"
    },
    {
      "key": "pantry_item_id",
      "value": ""
    },
    {
      "key": "shopping_item_id",
      "value": ""
    }
  ],
